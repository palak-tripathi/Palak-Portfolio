# Palak Tripathi — Developer Portfolio Environment Configuration
# Copy this file to .env and fill in your values for local development and deployment.
# NEVER commit your actual .env file or production secret keys to version control.

# Supabase Client Configuration (Public / Browser-safe)
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"

# Server-Side Supabase Configuration (Optional - for server routes)
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-publishable-key"
SUPABASE_PROJECT_ID="your-supabase-project-id"

# Server-Only Privileged Key (NEVER expose to frontend code)
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Optional AI Chatbot Provider Keys (Configure at least one to enable live LLM streaming)
# If left blank, the built-in intelligent local knowledge synthesizer responds seamlessly.
GEMINI_API_KEY="your-gemini-api-key"
# OPENAI_API_KEY="your-openai-api-key"
# GROQ_API_KEY=""
# ANTHROPIC_API_KEY=""

# Optional Database Migration Connection (PostgreSQL)
# LOVABLE_DB_MIGRATION_URL="postgres://postgres:password@localhost:5432/postgres"

